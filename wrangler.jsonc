// Cloudflare Workers：靜態網站＋Telegram 推播排程
{
  "name": "btc-radar",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "AlertState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlertState"] }]
}
